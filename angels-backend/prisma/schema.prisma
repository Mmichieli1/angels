datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Character {
  id            String                @id @default(uuid())
  userId        String                @unique
  name          String 
  genre         CharacterGenre        @default(MALE)
  race          CharacterRace         @default(HUMAN)
  className     CharacterClass        @default(WARRIOR) 
  level         Float                 @default(1)
  experience    Float                 @default(0)
  basicStats    BasicStats?
  lastPosition  LastPosition?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  @@unique([userId, name])
}

enum CharacterGenre {
  MALE
  FEMALE
}

enum CharacterRace {
  HUMAN
  ELF
}

enum CharacterClass {
  WARRIOR
  ROGUE
  MAGE
  PROPHET
}

model BasicStats {
  id             String                @id @default(uuid())
  strength       Float
  agility        Float
  intelligence   Float
  vitality       Float
  armor          Float
  damage         Float
  health         Float
  mana           Float
  characterId    String                @unique()
  character      Character             @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model LastPosition {
  id              String                @id @default(uuid())
  mapId           String
  y               Float
  z               Float
  x               Float
  characterId     String                @unique()
  character       Character             @relation(fields: [characterId], references: [id], onDelete: Cascade)
}